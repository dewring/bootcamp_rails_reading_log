{
  "name": "app",
  "private": true,
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "^0.28.1",
    "jsdom": "^30.1.3",
    "vite": "^8",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.ts --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "vitest run && node --test test/javascript/*.mjs"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@types/lodash": "^4.17.24",
    "html5-qrcode": "^2.3.8",
    "lodash": "^4.18.0",
    "typescript": "^7.0.2"
  }
}
