<div class="my-log-page">
  <div class="my-log-body">
    <%= render "sidebar" %>

    <section class="my-log-main" aria-label="Editorial library">
      <%= render "library_intro", reading_count: @reading_books.size %>

      <%= render "book_shelf",
            title: "Reading",
            subtitle: "Four books currently open",
            user_books: @reading_books,
            shelf_class: "my-log-section--reading" %>

      <%= render "book_shelf",
            title: "Want to Read",
            subtitle: "Saved for a future quiet hour",
            user_books: @want_to_read_books,
            shelf_class: "my-log-section--want-to-read" %>
    </section>
  </div>
</div>
