<% admin_layout = local_assigns.fetch(:admin_layout, false) %>
<% menu_id = admin_layout ? "admin_workspace_nav_menu" : "nav_menu_dropdown" %>
<% account_id = admin_layout ? "admin_workspace_account_menu" : "account_dropdown" %>
<ul class="<%= class_names("nav-actions", "admin-topbar-actions" => admin_layout) %>" aria-label="Site controls">
  <li class="nav-menu"
      data-controller="nav-menu"
      data-action="mouseenter->nav-menu#enter mouseleave->nav-menu#leave focusin->nav-menu#focusIn focusout->nav-menu#focusOut dropdown:opened@window->nav-menu#closeIfAnother click@document->nav-menu#closeOnOutsideClick keydown.esc@document->nav-menu#closeOnEscape">
    <button type="button"
            class="nav-action-button nav-menu-trigger"
            data-nav-menu-target="trigger"
            data-action="click->nav-menu#toggle"
            aria-expanded="false"
            aria-controls="<%= menu_id %>"
            aria-label="Menu">
      <%= image_tag "menu.svg", class: "nav-action-icon", alt: "" %>
    </button>
    <ul id="<%= menu_id %>"
        class="nav-dropdown"
        data-nav-menu-target="menu"
        hidden>
      <li>
        <%= link_to books_path, class: "nav-dropdown-item" do %>
          <%= image_tag "dropdown-grid.svg", class: "dropdown-item-icon", alt: "" %>
          <span>Catalog</span>
        <% end %>
      </li>
      <% if user_signed_in? %>
        <li>
          <%= link_to challenges_path, class: "nav-dropdown-item" do %>
            <%= image_tag "dropdown-trophy.svg", class: "dropdown-item-icon", alt: "" %>
            <span>Challenges</span>
          <% end %>
        </li>
        <li>
          <%= link_to book_clubs_path, class: "nav-dropdown-item" do %>
            <%= image_tag "dropdown-users.svg", class: "dropdown-item-icon", alt: "" %>
            <span>Book Clubs</span>
          <% end %>
        </li>
        <li class="nav-dropdown-divider" aria-hidden="true">
          <%= image_tag "dropdown-divider.svg", alt: "" %>
        </li>
        <li>
          <%= link_to dashboard_path, class: "nav-dropdown-item" do %>
            <%= image_tag "dropdown-book-open.svg", class: "dropdown-item-icon", alt: "" %>
            <span>My Log</span>
          <% end %>
        </li>
        <li>
          <%= link_to reviews_path, class: "nav-dropdown-item" do %>
            <%= image_tag "dropdown-star.svg", class: "dropdown-item-icon", alt: "" %>
            <span>Reviews</span>
          <% end %>
        </li>
        <li>
          <%= link_to reading_sessions_path, class: "nav-dropdown-item" do %>
            <%= image_tag "dropdown-history.svg", class: "dropdown-item-icon", alt: "" %>
            <span>History</span>
          <% end %>
        </li>
        <% if current_user.admin? %>
          <li class="nav-dropdown-divider" aria-hidden="true">
            <%= image_tag "dropdown-divider.svg", alt: "" %>
          </li>
          <li>
            <%= link_to admin_root_path, class: "nav-dropdown-item" do %>
              <%= image_tag "dropdown-grid.svg", class: "dropdown-item-icon", alt: "" %>
              <span>Manage</span>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </li>
  <% if user_signed_in? %>
    <%= render "notifications/panel", notification_panel_locals %>
  <% end %>
  <li class="account-menu"
      data-controller="account-dropdown"
      data-action="mouseenter->account-dropdown#enter mouseleave->account-dropdown#leave focusin->account-dropdown#focusIn focusout->account-dropdown#focusOut dropdown:opened@window->account-dropdown#closeIfAnother click@document->account-dropdown#closeOnOutsideClick keydown.esc@document->account-dropdown#closeOnEscape">
    <button type="button"
            class="nav-action-button nav-account-trigger"
            data-account-dropdown-target="trigger"
            data-action="click->account-dropdown#toggle"
            aria-expanded="false"
            aria-controls="<%= account_id %>"
            aria-label="Account">
      <%= image_tag "user.svg", class: "nav-action-icon account-icon", alt: "" %>
    </button>
    <ul id="<%= account_id %>"
        class="account-dropdown <%= "account-dropdown--signed-in" if user_signed_in? %>"
        data-account-dropdown-target="menu"
        hidden>
      <% if user_signed_in? %>
        <li>
          <%= link_to edit_user_registration_path, class: "account-dropdown-item" do %>
            <%= image_tag "dropdown-settings.svg", class: "dropdown-item-icon", alt: "" %>
            <span>Settings</span>
          <% end %>
        </li>
        <li class="account-dropdown-divider" aria-hidden="true">
          <%= image_tag "dropdown-divider.svg", alt: "" %>
        </li>
        <li>
          <%= link_to destroy_user_session_path,
                class: "account-dropdown-item account-dropdown-item--danger",
                data: { turbo_method: :delete } do %>
            <%= image_tag "dropdown-logout.svg", class: "dropdown-item-icon", alt: "" %>
            <span>Log Out</span>
          <% end %>
        </li>
      <% else %>
        <li>
          <%= link_to new_user_session_path, class: "account-dropdown-item account-dropdown-item--highlight" do %>
            <%= image_tag "dropdown-login.svg", class: "dropdown-item-icon", alt: "" %>
            <span>Sign In</span>
          <% end %>
        </li>
        <li>
          <%= link_to new_user_registration_path, class: "account-dropdown-item" do %>
            <%= image_tag "dropdown-user.svg", class: "dropdown-item-icon", alt: "" %>
            <span>Sign Up</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </li>
</ul>
