<% visible_types = types.select { |type| type.enabled? || counts.fetch(type.key, 0).positive? || selected&.kind == type.key } %>
<% selected_type = types.find { |type| type.key == selected.kind } if selected %>
<%= turbo_frame_tag dom_id(target, :reaction_panel), class: "reaction-panel", data: { reaction_url: reaction_selection_path(target) } do %>
  <section aria-labelledby="<%= dom_id(target, :reaction_heading) %>">
    <h3 id="<%= dom_id(target, :reaction_heading) %>">Reactions</h3>
    <ul id="<%= dom_id(target, :reaction_counts) %>" class="reaction-counts" aria-live="polite" aria-atomic="true">
      <% visible_types.each do |type| %>
        <li data-reaction-kind="<%= type.key %>"><%= type.emoji %> <%= type.label %>: <%= counts.fetch(type.key, 0) %></li>
      <% end %>
    </ul>
    <p data-reaction-selection><%= selected_type ? "Your reaction: #{selected_type.label}" : "No reaction selected" %></p>
    <% if local_assigns.fetch(:can_react) { policy(selected || target.reactions.build(user: current_user)).create? } %>
      <div class="reaction-controls">
        <% visible_types.each do |type| %>
          <%= button_to reaction_selection_path(target), method: :put, params: { kind: type.key },
                class: "reaction-button", disabled: !type.enabled?, aria: { pressed: selected&.kind == type.key } do %>
            <span aria-hidden="true"><%= type.emoji %></span>
            <span><%= type.label %></span>
          <% end %>
        <% end %>
        <%= button_to "Clear", reaction_selection_path(target), method: :delete, class: "reaction-button reaction-clear", disabled: selected.nil? %>
      </div>
    <% end %>
    <% if errors.any? %>
      <ul role="alert">
        <% errors.each do |error| %>
          <li><%= error %></li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
