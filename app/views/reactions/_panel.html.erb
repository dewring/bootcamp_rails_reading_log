<%= turbo_frame_tag dom_id(target, :reaction_panel) do %>
  <section aria-labelledby="<%= dom_id(target, :reaction_heading) %>">
    <h3 id="<%= dom_id(target, :reaction_heading) %>">Reactions</h3>
    <ul id="<%= dom_id(target, :reaction_counts) %>">
      <% types.each do |type| %>
        <li data-reaction-kind="<%= type.key %>"><%= type.emoji %> <%= type.label %>: <%= counts.fetch(type.key, 0) %></li>
      <% end %>
    </ul>
    <p data-reaction-selection><%= selected ? "Your reaction: #{selected.reaction_type.label}" : "No reaction selected" %></p>
    <% if errors.any? %>
      <ul role="alert">
        <% errors.each do |error| %>
          <li><%= error %></li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
