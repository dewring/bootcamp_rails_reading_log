<%= turbo_stream_from @book_club %>
<article>
  <hgroup>
    <h1><%= @book_club.name %></h1>
    <p><%= @book_club.description %></p>
  </hgroup>

  <p><%= pluralize(@book_club.book_club_memberships_count, "member") %></p>

  <% if policy(@book_club).join? %>
    <%= button_to "Join", join_book_club_path(@book_club), class: "btn-cta" %>
  <% elsif policy(@book_club).leave? %>
    <%= button_to "Leave", leave_book_club_path(@book_club), method: :delete,
          data: { turbo_confirm: "Leave this club?" }, class: "btn-md btn-danger" %>
  <% end %>

  <% if policy(@book_club).edit? %>
    <%= link_to "Edit Club", edit_book_club_path(@book_club), class: "btn-md" %>
  <% end %>

  <% if policy(@book_club).destroy? %>
    <%= button_to "Delete Club", @book_club, method: :delete,
          data: { turbo_confirm: "Delete this club? This cannot be undone." }, class: "btn-md btn-danger" %>
  <% end %>

  <ul>
    <% @book_club.book_club_memberships.includes(:user).each do |membership| %>
      <li><%= membership.user.nickname %> — <%= membership.role.humanize %></li>
    <% end %>
  </ul>
</article>

<%= render "current_pick", book_club: @book_club %>

<% if policy(@book_club).manage? %>
  <%= form_with model: @book_club, url: set_current_book_book_club_path(@book_club), method: :patch, html: { class: "form" } do |f| %>
    <div class="field" data-controller="book-picker">
      <%= f.label :current_book_search, "Current Pick" %>
      <input type="text" id="book_club_current_book_search" list="book_club_book_options"
             placeholder="Search books by title..." autocomplete="off"
             value="<%= @book_club.current_book&.title %>"
             data-book-picker-target="search" data-action="input->book-picker#input">
      <datalist id="book_club_book_options" data-book-picker-target="options">
        <% if @book_club.current_book %>
          <option value="<%= @book_club.current_book.title %>" data-id="<%= @book_club.current_book.id %>"></option>
        <% end %>
      </datalist>
      <%= f.hidden_field :current_book_id, data: { book_picker_target: "hidden" } %>
    </div>

    <div class="field">
      <%= f.label :reading_deadline %>
      <%= f.date_field :reading_deadline %>
    </div>

    <div class="form-submit">
      <%= f.submit "Update Pick" %>
    </div>
  <% end %>
<% end %>

<%= render "leaderboard", book_club: @book_club %>

<article>
  <h2>Past Picks</h2>
  <% if @book_club.pick_history.empty? %>
    <p>No past picks yet.</p>
  <% else %>
    <ul>
      <% @book_club.pick_history.each do |entry| %>
        <li><%= entry[:book]&.title || "Unknown book" %> — picked on <%= entry[:changed_at].to_date.to_fs(:long) %></li>
      <% end %>
    </ul>
  <% end %>
</article>
