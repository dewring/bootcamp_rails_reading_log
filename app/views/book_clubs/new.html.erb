<div class="book-club-detail-page">
  <%= render "club_sidebar", book_club: @book_club %>

  <div class="book-club-overview-content">
    <header class="book-club-detail-header">
      <div>
        <h1>Overview</h1>
        <p>NEW BOOK CLUB</p>
      </div>
    </header>

    <section class="book-club-owner-controls book-club-creation" aria-labelledby="club-creation-title">
      <div>
        <h2 id="club-creation-title">Create a book club</h2>
        <p>Name and description are required. Current pick and reading deadline are optional.</p>
      </div>
      <% if @book_club.errors.any? %>
        <div class="club-owner-errors" role="alert"><%= @book_club.errors.full_messages.to_sentence %></div>
      <% end %>
      <%= form_with model: @book_club, html: { class: "form" } do |f| %>
        <div class="admin-field"><%= f.label :name, "Club name" %><%= f.text_field :name, required: true %></div>
        <%= render "pick_fields", f: f, club: @book_club, search_url: search_books_book_clubs_path, search_id: "book_club_current_book_search", results_id: "club-book-results" %>
        <div class="admin-field"><%= f.label :description %><%= f.text_area :description, rows: 4, required: true %></div>
        <div class="form-submit">
          <%= link_to "Cancel", book_clubs_path, class: "book-club-action book-club-action--secondary" %>
          <%= f.submit "Create Book Club" %>
        </div>
      <% end %>
    </section>
  </div>
</div>
