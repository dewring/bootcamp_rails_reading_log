<li id="notifications_panel"
    class="notification-menu"
    data-controller="notification-dropdown"
    data-action="mouseenter->notification-dropdown#enter mouseleave->notification-dropdown#leave focusin->notification-dropdown#focusIn focusout->notification-dropdown#focusOut dropdown:opened@window->notification-dropdown#closeIfAnother click@document->notification-dropdown#closeOnOutsideClick keydown.esc@document->notification-dropdown#closeOnEscape">
  <%= turbo_frame_tag "notifications_frame", target: "_top" do %>
    <button type="button"
            class="nav-action-button notification-trigger"
            data-notification-dropdown-target="trigger"
            data-action="click->notification-dropdown#toggle"
            aria-expanded="false"
            aria-controls="notifications_dropdown"
            aria-label="Notifications">
      <%= image_tag "bell.svg", class: "nav-action-icon notification-icon", alt: "" %>
      <% if unread_count.positive? %>
        <span class="notification-count" aria-label="<%= pluralize(unread_count, "unread notification") %>"><%= unread_count %></span>
      <% end %>
    </button>

    <div id="notifications_dropdown"
         class="notifications-dropdown"
         data-notification-dropdown-target="menu"
         hidden>
      <header class="notifications-header">
        <h2>Notifications</h2>
        <%= link_to "↻ Refresh", notifications_path, class: "notifications-refresh", aria: { label: "Refresh notifications" }, data: { turbo_frame: "notifications_frame", turbo_prefetch: false } %>
      </header>

      <% if notifications.empty? %>
        <p>No notifications yet.</p>
      <% else %>
        <ul class="notification-list">
          <% notifications.each do |notification| %>
            <li id="<%= dom_id(notification) %>" class="<%= "notification-unread" if notification.unread? %>">
              <span class="notification-indicator" aria-hidden="true"></span>
              <div class="notification-content">
                <% if notification.record.present? %>
                  <%= link_to notification.message, book_club_path(notification.record) %>
                <% else %>
                  <span><%= notification.message %></span>
                <% end %>
                <small><%= l(notification.created_at, format: :short) %></small>
              </div>

              <% if notification.unread? %>
                <%= button_to "Mark as read",
                      notification_path(notification),
                      method: :patch,
                      form: { data: { turbo_stream: true } },
                      class: "btn-sm" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>
</li>
