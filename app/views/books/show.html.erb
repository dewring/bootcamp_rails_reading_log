<%
  ratings = @reviews.map(&:rating).compact
  average_rating = ratings.any? ? format("%.1f", ratings.sum.to_f / ratings.size) : "0.0"
  rounded_rating = average_rating.to_f.round
  description = @book.description.to_s
  main_description = description.gsub(/\(\[source\]\(.*?\)\)/, "").strip
  source_match = description.match(/\(\[source\]\((.*?)\)\)/)
  edition_for_details = @book_editions.find { |edition| edition.publish_year.present? || edition.language.present? } || @book_editions.first
  publication_details = [
    ("Published #{edition_for_details.publish_year}" if edition_for_details&.publish_year.present?),
    ("#{@book.total_pages} pages" if @book.total_pages.present?)
  ].compact.join(" · ")
  language_details = [edition_for_details&.language, @book.subjects&.first].compact_blank.join(" · ")
%>

<main class="book-detail-page">
  <nav class="book-detail-breadcrumb" aria-label="Breadcrumb">
    <%= link_to "Catalog", books_path %>
    <span aria-hidden="true">/</span>
    <span><%= @book.title %></span>
  </nav>

  <section class="book-detail-hero" aria-labelledby="book-detail-title">
    <div class="book-detail-cover-frame">
      <% if @book.cover_image.attached? %>
        <%= image_tag @book.cover_image.variant(resize_to_limit: [ 250, 368 ]), class: "book-show-image book-detail-cover-image", alt: "Cover of #{@book.title}" %>
      <% else %>
        <div class="book-show-no-cover book-detail-no-cover" aria-label="No cover available">📚</div>
      <% end %>
    </div>

    <div class="book-detail-intro">
      <h1 id="book-detail-title" class="book-detail-title"><%= @book.title %></h1>
      <p class="book-detail-author">by <%= @book.author %></p>

      <div class="book-detail-rating" aria-label="Average rating <%= average_rating %> out of 5">
        <span class="book-detail-stars" aria-hidden="true"><%= "★" * rounded_rating %><%= "☆" * (5 - rounded_rating) %></span>
        <strong><%= average_rating %></strong>
        <span><%= pluralize(@reviews.size, "community review") %></span>
      </div>

      <div class="book-detail-actions">
        <% if user_signed_in? %>
          <% user_book = current_user.user_books.find_by(book: @book) %>
          <% has_reading_session = current_user.reading_sessions.exists?(book: @book) %>
          <% currently_reading = user_book&.status.in?([ "reading", "finished" ]) || has_reading_session %>

          <% if currently_reading %>
            <% reading_destination = user_book&.status == "finished" ? book_finished_journal_path(@book) : dashboard_path %>
            <%= link_to reading_destination, class: "book-detail-state book-detail-state-reading action-button action-button--active" do %>
              <span aria-hidden="true">✓</span>
              <span>Currently Reading</span>
            <% end %>
          <% elsif policy(ReadingSession.new(user: current_user, book: @book)).new? %>
            <%= link_to book_reading_journal_path(@book), class: "book-detail-button book-detail-button-primary action-button action-button--primary" do %>
              <%= image_tag "detail-book-open.svg", alt: "", aria: { hidden: true } %>
              <span>Start Reading</span>
            <% end %>
          <% end %>

          <% if user_book&.status == "want_to_read" %>
            <%= button_to user_book_path(user_book),
                          method: :delete,
                          params: { return_to: "book" },
                          form: { class: "book-detail-inline-form" },
                          class: "book-detail-state book-detail-state-want action-button action-button--active" do %>
              <%= image_tag "detail-bookmark.svg", alt: "", aria: { hidden: true } %>
              <span>Saved to Want to Read</span>
            <% end %>
          <% elsif user_book && user_book.status != "reading" %>
            <%= button_to user_book_path(user_book),
                          method: :patch,
                          params: { user_book: { status: "want_to_read" } },
                          form: { class: "book-detail-inline-form" },
                          class: "book-detail-button book-detail-button-secondary action-button action-button--secondary" do %>
              <%= image_tag "detail-bookmark.svg", alt: "", aria: { hidden: true } %>
              <span>Want to Read</span>
            <% end %>
          <% elsif policy(UserBook.new(user: current_user, book: @book)).new? %>
            <%= button_to user_books_path,
                          params: { user_book: { book_id: @book.id, status: "want_to_read" } },
                          form: { class: "book-detail-inline-form" },
                          class: "book-detail-button book-detail-button-secondary action-button action-button--secondary" do %>
              <%= image_tag "detail-bookmark.svg", alt: "", aria: { hidden: true } %>
              <span>Want to Read</span>
            <% end %>
          <% end %>
        <% end %>

        <% if policy(@book).edit? %>
          <%= link_to admin_catalog_path(book_id: @book.id), class: "book-detail-button book-detail-button-secondary action-button action-button--secondary" do %>
            <%= image_tag "detail-pencil.svg", alt: "", aria: { hidden: true } %>
            <span>Edit</span>
          <% end %>
          <p class="book-detail-admin-note">Admin view · Edit action visible</p>
        <% end %>
      </div>
    </div>
  </section>

  <section class="book-detail-information" aria-labelledby="book-detail-information-title">
    <div class="book-detail-description">
      <h2 id="book-detail-information-title">About this book</h2>
      <% if main_description.present? %>
        <p><%= main_description %></p>
      <% else %>
        <p class="book-detail-muted">No description is available for this book yet.</p>
      <% end %>
      <% if source_match %>
        <p class="book-detail-source"><%= link_to "View source", source_match[1], target: "_blank", rel: "noopener" %></p>
      <% end %>
      <% if @book.subjects.present? %>
        <div class="book-detail-subjects" aria-label="Subjects">
          <% @book.subjects.each do |subject| %>
            <span><%= subject %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <aside class="book-detail-facts" aria-labelledby="book-detail-facts-title">
      <h2 id="book-detail-facts-title">Genres &amp; details</h2>
      <% if @book.genres.any? %>
        <div class="book-detail-genres" aria-label="Genres">
          <% @book.genres.each do |genre| %>
            <span><%= genre.name %></span>
          <% end %>
        </div>
      <% end %>
      <% if publication_details.present? %>
        <p><%= publication_details %></p>
      <% end %>
      <% if language_details.present? %>
        <p><%= language_details %></p>
      <% end %>
    </aside>
  </section>

  <% my_review = user_signed_in? ? current_user.reviews.find_by(book: @book) : nil %>
  <% can_write_review = user_signed_in? && policy(Review.new(user: current_user, book: @book)).new? %>
  <% can_edit_review = my_review.present? && policy(my_review).edit? %>
  <% review_composer_enabled = can_write_review || can_edit_review %>

  <section class="book-detail-reviews" aria-labelledby="book-detail-reviews-title" data-controller="review-composer">
    <div class="book-detail-section-heading">
      <div>
        <h2 id="book-detail-reviews-title">Reader reflections</h2>
        <p>What BookNook readers are saying about this book.</p>
      </div>
      <% if user_signed_in? %>
        <% if can_edit_review %>
          <button type="button"
                  class="book-detail-button book-detail-button-secondary"
                  data-action="click->review-composer#open">
            <%= image_tag "review-message-square.svg", alt: "", aria: { hidden: true } %>
            <span>Edit my Review</span>
          </button>
        <% elsif can_write_review && @reviews.any? %>
          <button type="button"
                  class="book-detail-button book-detail-button-secondary"
                  data-action="click->review-composer#open">
            <%= image_tag "review-message-square.svg", alt: "", aria: { hidden: true } %>
            <span>Write a Review</span>
          </button>
        <% end %>
      <% end %>
    </div>

    <% if @reviews.empty? %>
      <div class="book-detail-review-empty" data-review-composer-target="closed">
        <%= image_tag "review-empty-message-square.svg", class: "book-detail-empty-icon", alt: "", aria: { hidden: true } %>
        <h3>No reviews yet</h3>
        <p>Be the first reader to share a thoughtful review.</p>
        <% if can_write_review %>
          <button type="button"
                  class="book-detail-button book-detail-button-secondary"
                  data-action="click->review-composer#open">
            <%= image_tag "review-message-square.svg", alt: "", aria: { hidden: true } %>
            <span>Write a Review</span>
          </button>
        <% end %>
      </div>
    <% else %>
      <div class="book-detail-review-grid">
        <% @reviews.each do |review| %>
          <article class="book-detail-review-card">
            <div class="book-detail-review-header">
              <div class="book-detail-reviewer">
                <%= render "users/avatar", user: review.user, variant: :review %>
                <div>
                  <strong><%= review.user.nickname %></strong>
                  <time datetime="<%= review.created_at.iso8601 %>"><%= review.created_at.strftime("%b %-d, %Y") %></time>
                </div>
              </div>
              <% if review.rating %>
                <span class="book-detail-review-stars" aria-label="<%= review.rating %> out of 5 stars"><%= "★" * review.rating.to_i %></span>
              <% end %>
            </div>
            <p><%= review.body %></p>
          </article>
        <% end %>
      </div>
    <% end %>

    <% if review_composer_enabled %>
      <div class="book-detail-review-composer" data-review-composer-target="composer" hidden>
        <div class="book-detail-review-composer-heading">
          <div>
            <h3><%= can_edit_review ? "Edit a review" : "Write a review" %></h3>
            <p><%= @book.title %> · <%= @book.author %></p>
          </div>
          <button type="button"
                  class="book-detail-review-close"
                  aria-label="Close review composer"
                  data-action="click->review-composer#close">
            <%= image_tag "review-close.svg", alt: "", aria: { hidden: true } %>
          </button>
        </div>

        <% review_form_model = can_edit_review ? my_review : Review.new %>
        <%= form_with model: [@book, review_form_model], class: "book-detail-review-form", data: { review_composer_target: "form" } do |f| %>
          <div class="book-detail-review-rating" role="radiogroup" aria-label="Select a rating">
            <div class="book-detail-review-stars-input">
              <% (1..5).each do |rating| %>
                <%= f.radio_button :rating,
                                   rating,
                                   id: "book_review_rating_#{rating}",
                                   data: { action: "change->review-composer#updateRating" } %>
                <label for="book_review_rating_<%= rating %>"
                       aria-label="<%= rating %> out of 5 stars"
                       data-review-composer-target="ratingStar">★</label>
              <% end %>
            </div>
            <span data-review-composer-target="ratingHint">Select a rating</span>
          </div>

          <%= f.text_area :body,
                          maxlength: 2000,
                          placeholder: "What stayed with you? Share your perspective with the BookNook community...",
                          data: { review_composer_target: "body", action: "input->review-composer#updateCount" } %>

          <div class="book-detail-review-composer-actions">
            <span data-review-composer-target="counter">0 / 2,000 characters</span>
            <div>
              <button type="button"
                      class="book-detail-button book-detail-button-secondary"
                      data-action="click->review-composer#close">
                <span>Cancel</span>
              </button>
              <button type="submit" class="book-detail-button book-detail-button-primary">
                <%= image_tag "review-send.svg", alt: "", aria: { hidden: true } %>
                <span><%= can_edit_review ? "Update Review" : "Submit Review" %></span>
              </button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <% if @book_editions.any? %>
    <section class="book-detail-editions" aria-labelledby="book-detail-editions-title">
      <div class="book-detail-section-heading">
        <div>
          <h2 id="book-detail-editions-title">Other editions</h2>
          <p>Explore available editions of this book.</p>
        </div>
      </div>

      <div class="book-detail-edition-grid">
        <% @book_editions.each do |edition| %>
          <% cache edition do %>
            <%= link_to "https://openlibrary.org#{edition.ol_edition_key}", target: "_blank", rel: "noopener", class: "book-detail-edition-card" do %>
              <div class="book-detail-edition-cover">
                <% if edition.cover_image.attached? %>
                  <%= image_tag edition.cover_image, alt: "Cover of #{edition.title.presence || @book.title}" %>
                <% else %>
                  <div class="book-detail-edition-no-cover" aria-label="No cover available">📚</div>
                <% end %>
              </div>
              <div>
                <h3><%= edition.title.presence || @book.title %></h3>
                <p><%= @book.author %></p>
                <small><%= [ edition.publisher, edition.publish_year, edition.language ].compact_blank.join(" · ") %></small>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</main>
