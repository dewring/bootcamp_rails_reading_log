<%= render "devise/shared/auth_shell", mode: :login do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="auth-fields">
      <div class="auth-field">
        <%= f.label :email, "Email Address" %>
        <%= f.email_field :email, placeholder: "you@example.com", autofocus: true, autocomplete: "email" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "Password" %>
        <div class="auth-input-wrap">
          <%= f.password_field :password, placeholder: "••••••••", autocomplete: "current-password" %>
          <%= image_tag "auth-login-logo-book.svg", class: "auth-password-icon", alt: "" %>
        </div>
      </div>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="auth-login-options">
        <label class="auth-check-label">
          <%= f.check_box :remember_me %>
          <span>Remember me</span>
        </label>
        <%= link_to "Forgot password?", new_password_path(resource_name), class: "auth-inline-link" %>
      </div>
    <% end %>

    <div class="auth-submit">
      <%= f.submit "Log In" %>
    </div>
  <% end %>
<% end %>
