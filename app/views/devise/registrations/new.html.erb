<%= render "devise/shared/auth_shell", mode: :sign_up do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="auth-fields auth-fields--sign-up">
      <div class="auth-name-row">
        <div class="auth-field">
          <%= f.label :first_name, "First name" %>
          <%= f.text_field :first_name, placeholder: "Jane", autocomplete: "given-name" %>
        </div>
        <div class="auth-field">
          <%= f.label :last_name, "Last name" %>
          <%= f.text_field :last_name, placeholder: "Doe", autocomplete: "family-name" %>
        </div>
      </div>

      <div class="auth-field">
        <%= f.label :nickname, "Nickname" %>
        <%= f.text_field :nickname, placeholder: "booklover42", autocomplete: "nickname" %>
      </div>

      <div class="auth-field">
        <%= f.label :email, "Email Address" %>
        <%= f.email_field :email, placeholder: "you@example.com", autofocus: true, autocomplete: "email" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "Password" %>
        <div class="auth-input-wrap">
          <%= f.password_field :password, placeholder: "Minimum #{@minimum_password_length} characters", autocomplete: "new-password" %>
          <%= image_tag "auth-signup-logo-book.svg", class: "auth-password-icon", alt: "" %>
        </div>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation, "Confirm Password" %>
        <div class="auth-input-wrap">
          <%= f.password_field :password_confirmation, placeholder: "Repeat your password", autocomplete: "new-password" %>
          <%= image_tag "auth-signup-logo-book.svg", class: "auth-password-icon", alt: "" %>
        </div>
      </div>
    </div>

    <label class="auth-terms-label">
      <input type="checkbox" aria-label="Agree to the BookNook Terms of Service and Privacy Policy.">
      <span>I agree to the BookNook Terms of Service and Privacy Policy.</span>
    </label>

    <div class="auth-submit">
      <%= f.submit "Create Account" %>
    </div>
  <% end %>
<% end %>
