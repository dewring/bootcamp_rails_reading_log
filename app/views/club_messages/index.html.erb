<% turbo_exempts_page_from_cache %>
<div data-controller="club-discussion"
     data-club-discussion-book-club-id-value="<%= @book_club.id %>"
     data-club-discussion-page-value="<%= @pagy.page %>"
     data-club-discussion-total-posts-value="<%= @pagy.count %>"
     data-action="turbo:before-cache@document->club-discussion#beforeCache">
  <div class="book-club-detail-page" data-club-discussion-target="content">
    <%= render "book_clubs/club_sidebar", book_club: @book_club %>

    <section class="book-club-overview-content" aria-labelledby="discussion-title">
      <header class="book-club-detail-header">
        <div>
          <h1 id="discussion-title">Discussion</h1>
          <p><span><%= @book_club.name %></span> · CURRENT CYCLE</p>
        </div>
        <%= render "book_clubs/membership_status", book_club: @book_club %>
      </header>

      <div class="club-discussion-body">
        <section class="book-club-overview-card club-discussion-history" aria-labelledby="club-discussion-history-title">
          <h2 id="club-discussion-history-title">All Threads</h2>

          <p class="club-discussion-empty" data-club-discussion-target="emptyState" <%= "hidden" unless @messages.empty? %>>No discussion posts yet.</p>
          <div data-club-discussion-target="messages">
            <% @messages.each do |message| %>
              <article id="<%= dom_id(message) %>" class="club-discussion-message" data-message-id="<%= message.id %>">
                <header class="club-discussion-message-meta">
                  <strong><%= message.user.nickname %></strong>
                  <time datetime="<%= message.created_at.iso8601(6) %>"><%= message.created_at.strftime("%b %-d, %Y · %H:%M") %></time>
                </header>
                <p class="club-discussion-message-body"><%= message.body %></p>
              </article>
            <% end %>
          </div>
        </section>

        <% if policy(@book_club).post_message? %>
          <section class="club-discussion-composer" aria-labelledby="club-discussion-composer-title">
            <header>
              <%= render "users/avatar", user: current_user, variant: :club_member %>
              <div>
                <h2 id="club-discussion-composer-title">Add a discussion post</h2>
                <p>Posting as <%= current_user.nickname %></p>
              </div>
            </header>
            <form data-action="submit->club-discussion#postMessage" data-turbo="false">
              <%= label_tag :club_message_body, "Your discussion post", class: "club-discussion-body-label" %>
              <%= text_area_tag :club_message_body, nil, required: true, maxlength: 1_000, rows: 6, placeholder: "Share a thought, question, or favorite line…", aria: { describedby: "club-discussion-composer-hint" }, data: { club_discussion_target: "body" } %>
              <footer>
                <p id="club-discussion-composer-hint">Mark spoilers kindly</p>
                <%= button_tag "Post", type: :submit, disabled: true, data: { club_discussion_target: "submit" } %>
              </footer>
              <p role="status" data-club-discussion-target="composerStatus"></p>
            </form>
          </section>
        <% end %>
      </div>

      <footer class="club-discussion-pagination">
        <p data-club-discussion-target="paginationSummary"><%= pluralize(@pagy.count, "post") %> · Page <%= @pagy.page %> of <%= @pagy.last %></p>
        <div data-club-discussion-target="pagination"><%== @pagy.series_nav if @pagy.last > 1 %></div>
        <%= link_to "Older posts", book_club_club_messages_path(@book_club, page: 2), data: { club_discussion_target: "olderPosts" }, hidden: true %>
      </footer>
    </section>
  </div>
  <p role="status" data-club-discussion-target="status" hidden></p>
</div>
