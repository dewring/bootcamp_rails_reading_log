<section class="home-section home-trending" aria-labelledby="home-trending-title">
  <header class="home-section-header">
    <h2 id="home-trending-title">Trending</h2>
  </header>
  <% if @trending_books.empty? %>
    <%= render "shared/empty_state", size: :compact, icon: "challenges-library.svg",
          title: "Nothing is trending yet",
          message: "No books have qualifying reactions in the last seven days.",
          action_label: "Browse the catalog", action_path: books_path %>
  <% else %>
    <div class="home-carousel-track">
      <div class="book-row">
        <% @trending_books.each do |book| %>
          <%= render "home/ranked_book_card", book: book, total_reactions: @trending_reaction_totals.fetch(book.id, 0) %>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
