<%= link_to book_path(book), class: "book-card" do %>
  <% if book.cover_image.attached? %>
    <%= image_tag book.cover_image.variant(resize_to_fill: [160, 240]), class: "book-cover", alt: book.title %>
  <% else %>
    <%= render "books/cover_fallback", title: book.title, author: book.author, seed: book.id,
          size: :medium, sizing_class: "book-cover" %>
  <% end %>
  <p class="book-title"><%= book.title %></p>
  <p class="book-author"><%= book.author %></p>
<% end %>
