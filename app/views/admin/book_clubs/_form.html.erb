<% if club.errors.any? %>
  <div class="admin-club-errors" role="alert"><p><%= club.errors.full_messages.to_sentence %></p></div>
<% end %>
<%= form_with model: [:admin, club], class: "admin-club-form" do |f| %>
  <%= hidden_field_tag :q, @query if @query.present? %>
  <%= hidden_field_tag :sort, @sort %>
  <%= hidden_field_tag :page, params[:page] if params[:page].present? %>
  <div class="admin-club-field-grid">
    <div class="admin-field"><%= f.label :name, "Club name" %><%= f.text_field :name, required: true %></div>
    <div class="admin-field"><%= label_tag "admin_club_owner", "Owner" %><%= text_field_tag :admin_club_owner, club.persisted? ? admin_club_owner(club) : current_user.nickname, readonly: true %></div>
    <div class="admin-field admin-club-book-search" data-controller="club-book-search" data-club-book-search-url-value="<%= search_books_admin_book_clubs_path %>" data-action="click@document->club-book-search#closeUnlessInside">
      <%= label_tag :admin_club_current_book_search, "Current pick" %>
      <%= text_field_tag :admin_club_current_book_search, club.current_book ? "#{club.current_book.title} · #{club.current_book.author}" : nil, placeholder: "Search title or author…", autocomplete: "off", role: "combobox", aria: { expanded: "false", controls: "admin-club-book-results", autocomplete: "list" }, data: { club_book_search_target: "search", action: "input->club-book-search#search keydown.down->club-book-search#next keydown.up->club-book-search#previous keydown.enter->club-book-search#choose keydown.esc->club-book-search#close" } %>
      <%= f.hidden_field :current_book_id, data: { club_book_search_target: "value" } %>
      <div id="admin-club-book-results" class="catalog-dropdown-menu admin-select-menu" role="listbox" aria-label="Matching books" data-club-book-search-target="results" hidden></div>
      <span class="admin-catalog-sr-only" role="status" data-club-book-search-target="status"></span>
    </div>
    <div class="admin-field"><%= label_tag "admin_club_members", "Members" %><%= text_field_tag :admin_club_members, pluralize(club.book_club_memberships_count, "member"), readonly: true %></div>
    <div class="admin-field admin-club-deadline"><%= f.label :reading_deadline, "Reading deadline" %><%= f.date_field :reading_deadline %></div>
    <div class="admin-field admin-club-description"><%= f.label :description %><%= f.text_area :description, rows: 4 %></div>
  </div>
  <div class="admin-club-form-actions">
    <%= link_to "Cancel", admin_book_clubs_path(club_id: (club.id if club.persisted?), q: @query.presence, sort: @sort, page: params[:page]), class: "admin-secondary-button" if @is_new_club %>
    <%= f.submit club.persisted? ? "Save changes" : "Create Club", class: "admin-primary-button" %>
  </div>
<% end %>
