<% content_for :title, "Reading Activity Report · BookNook" %>

<div class="admin-page admin-page--reports">
  <%= render "admin/shared/topbar" %>
  <div class="admin-body">
    <%= render "admin/shared/sidebar", active_section: :reports %>

    <main class="admin-main" aria-labelledby="admin-report-title">
      <div class="admin-page-heading">
        <div>
          <p class="admin-eyebrow">READING INSIGHTS</p>
          <h1 id="admin-report-title">Reading Activity Report</h1>
          <p class="admin-page-description">Period overview and sortable Top 10 leaderboards. Aggregates only.</p>
        </div>
      </div>

      <section class="admin-report-range" aria-labelledby="admin-report-range-title">
        <h2 id="admin-report-range-title"><%= report_range_title(@period) %></h2>

        <%= form_with url: admin_report_path, method: :get, class: "admin-report-period-form", data: { controller: "submit-on-change" } do |f| %>
          <%= f.label :period, "Period" %>
          <%= f.select :period, ReportPeriod::PERIOD_OPTIONS, { selected: @period.preset }, data: { action: "change->submit-on-change#submit" } %>
          <% if @period.custom? %>
            <%= f.label :start, "Start date" %>
            <%= f.date_field :start, value: @period.start_param, max: @as_of.to_date.iso8601 %>
            <%= f.label :end, "End date" %>
            <%= f.date_field :end, value: @period.end_param, max: @as_of.to_date.iso8601 %>
          <% end %>
          <%= hidden_field_tag :tab, @leaderboard_tab %>
          <%= hidden_field_tag :sort, @leaderboard.sort %>
          <%= f.submit "Apply" %>
        <% end %>

        <% unless @period.valid? %>
          <p class="admin-report-error" role="alert">
            <%= @period.error_message %> Showing <%= report_date(@period.start_on) %> instead.
          </p>
        <% end %>

        <p class="admin-report-as-of">
          As of <time datetime="<%= @as_of.utc.iso8601 %>" data-controller="local-time"><%= @as_of.utc.to_fs(:long) %> UTC</time> · dates are read_on calendar days
        </p>
      </section>

      <section class="admin-report-overview" aria-labelledby="admin-report-overview-title">
        <h2 id="admin-report-overview-title">Overview</h2>
        <dl class="admin-report-stats">
          <div class="admin-report-stat">
            <dt>Active readers</dt>
            <dd class="admin-report-stat-value"><%= number_with_delimiter(@totals.active_readers) %> readers</dd>
            <dd class="admin-report-stat-rule">Distinct over period</dd>
          </div>
          <div class="admin-report-stat">
            <dt>Reading sessions</dt>
            <dd class="admin-report-stat-value"><%= number_with_delimiter(@totals.sessions) %> sessions</dd>
            <dd class="admin-report-stat-rule">Total in period</dd>
          </div>
          <div class="admin-report-stat">
            <dt>Pages read</dt>
            <dd class="admin-report-stat-value"><%= number_with_delimiter(@totals.pages_read) %> pages</dd>
            <dd class="admin-report-stat-rule">Total in period</dd>
          </div>
          <div class="admin-report-stat">
            <dt>Books read</dt>
            <dd class="admin-report-stat-value"><%= number_with_delimiter(@totals.books) %> books</dd>
            <dd class="admin-report-stat-rule">Distinct over period</dd>
          </div>
        </dl>
      </section>

      <div class="admin-report-main">
        <section class="admin-report-leaderboards" aria-labelledby="admin-report-leaderboards-title">
          <h2 id="admin-report-leaderboards-title">Leaderboards</h2>
          <nav class="admin-report-tabs" aria-label="Leaderboard type">
            <%= link_to admin_report_path(report_period_params(@period).merge(tab: "most_read")), class: "admin-report-tab#{' is-active' if @leaderboard_tab == 'most_read'}", aria: { current: ("page" if @leaderboard_tab == "most_read") } do %>
              Most read <span class="admin-report-tab-count"><%= number_with_delimiter(@totals.books) %></span>
            <% end %>
            <%= link_to admin_report_path(report_period_params(@period).merge(tab: "most_reactions")), class: "admin-report-tab#{' is-active' if @leaderboard_tab == 'most_reactions'}", aria: { current: ("page" if @leaderboard_tab == "most_reactions") } do %>
              Most reactions <span class="admin-report-tab-count"><%= number_with_delimiter(@reacted_book_count) %></span>
            <% end %>
            <%= link_to admin_report_path(report_period_params(@period).merge(tab: "power_users")), class: "admin-report-tab#{' is-active' if @leaderboard_tab == 'power_users'}", aria: { current: ("page" if @leaderboard_tab == "power_users") } do %>
              Power users <span class="admin-report-tab-count"><%= number_with_delimiter(@totals.active_readers) %></span>
            <% end %>
          </nav>

          <%= form_with url: admin_report_path, method: :get, class: "admin-report-sort-form", data: { controller: "submit-on-change" } do |f| %>
            <% report_period_params(@period).each do |name, value| %>
              <%= hidden_field_tag name, value %>
            <% end %>
            <%= hidden_field_tag :tab, @leaderboard_tab %>
            <%= f.label :sort, "Sort by" %>
            <%= f.select :sort, @leaderboard.sort_options, { selected: @leaderboard.sort }, data: { action: "change->submit-on-change#submit" } %>
            <%= f.submit "Sort" %>
          <% end %>

          <% if @leaderboard_tab == "power_users" %>
            <%= render "admin/reports/power_users_table", leaderboard: @leaderboard, period: @period %>
          <% elsif @leaderboard_tab == "most_reactions" %>
            <%= render "admin/reports/most_reactions_table", leaderboard: @leaderboard %>
          <% else %>
            <%= render "admin/reports/most_read_table", leaderboard: @leaderboard, total_pages_read: @totals.pages_read %>
          <% end %>
        </section>

        <aside class="admin-report-health" aria-labelledby="admin-report-health-title">
          <h2 id="admin-report-health-title">Report health</h2>

          <section class="admin-report-health-card" aria-labelledby="admin-report-import-title">
            <h3 id="admin-report-import-title">Import completeness</h3>
            <dl>
              <dt>Imported Works</dt>
              <dd><%= @import_completeness.imported_count %> / <%= @import_completeness.selected_count %></dd>
              <dt>Completeness</dt>
              <dd><%= report_percentage(@import_completeness.imported_count, @import_completeness.selected_count) %></dd>
              <dt>Missing</dt>
              <dd><%= @import_completeness.missing_count %> · not replaced with placeholder books</dd>
            </dl>
          </section>

          <section class="admin-report-health-card" aria-labelledby="admin-report-freshness-title">
            <h3 id="admin-report-freshness-title">ReadingMetric freshness</h3>
            <p class="admin-report-health-status admin-report-health-status--<%= @metric_freshness.status.dasherize %>"><%= report_freshness_label(@metric_freshness.status) %></p>
            <% if @metric_freshness.oldest_calculated_at %>
              <dl>
                <dt>Oldest calculated_at</dt>
                <dd>
                  <time datetime="<%= @metric_freshness.oldest_calculated_at.utc.iso8601 %>" data-controller="local-time"><%= @metric_freshness.oldest_calculated_at.utc.to_fs(:long) %> UTC</time>
                  · <%= @metric_freshness.minutes_old(@as_of) %> min before as_of
                </dd>
                <dt>Readers with metrics</dt>
                <dd><%= @metric_freshness.metric_count %> / <%= @metric_freshness.reader_count %></dd>
              </dl>
            <% end %>
            <p class="admin-report-health-note">ReadingMetricsJob recalculates every 10 minutes while the job worker runs.</p>
          </section>
        </aside>
      </div>
    </main>
  </div>
</div>
