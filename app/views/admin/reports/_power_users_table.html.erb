<table class="admin-report-table">
  <caption>Readers by read_on in this period · tied readers share a rank</caption>
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Reader</th>
      <th scope="col" aria-sort="<%= report_aria_sort(leaderboard, 'active_days') %>">Active days</th>
      <th scope="col" aria-sort="<%= report_aria_sort(leaderboard, 'sessions') %>">Sessions</th>
      <th scope="col" aria-sort="<%= report_aria_sort(leaderboard, 'pages_read') %>">Pages</th>
      <th scope="col" aria-sort="<%= report_aria_sort(leaderboard, 'books') %>">Books</th>
    </tr>
  </thead>
  <tbody>
    <% if rows.empty? %>
      <tr>
        <td colspan="6">No readers were active in this period.</td>
      </tr>
    <% end %>
    <% rows.each do |row| %>
      <tr>
        <td><%= row.rank %></td>
        <th scope="row">
          <%= row.reader_name %>
          <span class="admin-report-table-subtext">user_id <%= row.user.id %></span>
        </th>
        <td><%= row.active_days %> / <%= period.date_count %></td>
        <td><%= number_with_delimiter(row.sessions) %></td>
        <td><%= number_with_delimiter(row.pages_read) %></td>
        <td><%= number_with_delimiter(row.books) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
